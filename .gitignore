# WorkBuddy 项目数据（非源码，不入库）
.workbuddy/

# 系统/编辑器
.DS_Store
*.log
.idea/
.vscode/

# Python
__pycache__/
*.pyc
.pytest_cache/

# Cocos Creator 生成物/缓存（不入库）
.creator/
temp/
build/

# Cocos Creator 编辑器本地状态/导入缓存（可重建，不入库）
# library/ 为资源导入缓存；profiles/ 与 settings/v2/packages/ 为编辑器/插件本地视图与配置状态
# 这些文件每次打开项目都会被改写，不应进入版本管理
library/
profiles/
settings/v2/packages/
